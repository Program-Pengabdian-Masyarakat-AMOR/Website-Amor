# Salin ke .env lalu isi nilainya. JANGAN commit .env.

# Server
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Auth
JWT_SECRET=ganti-dengan-string-acak-panjang
JWT_EXPIRES_IN=12h

# Database (SQLite untuk dev; ganti ke PostgreSQL saat deploy)
DATABASE_URL="file:./dev.db"

# Firebase Realtime Database URL (wajib)
FIREBASE_DATABASE_URL=

# Kredensial Admin — pilih SALAH SATU cara:
# (A) Disarankan: taruh file service account JSON di backend/ (mis. serviceAccount.json)
FIREBASE_SERVICE_ACCOUNT=./serviceAccount.json
# (B) Atau isi tiga variabel ini (kosongkan FIREBASE_SERVICE_ACCOUNT bila pakai cara ini):
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Tempel private_key apa adanya di antara tanda kutip (biarkan \n literalnya)
FIREBASE_PRIVATE_KEY=""
