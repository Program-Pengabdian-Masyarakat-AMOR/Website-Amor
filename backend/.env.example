# Salin ke .env lalu isi nilainya. JANGAN commit .env.

# Server
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Auth
JWT_SECRET=ganti-dengan-string-acak-panjang
JWT_EXPIRES_IN=12h

# Database (SQLite untuk dev; ganti ke PostgreSQL saat deploy)
DATABASE_URL="file:./dev.db"

# Firebase Realtime Database URL (wajib)
FIREBASE_DATABASE_URL=

# Kredensial Admin — pilih SALAH SATU cara:
# (A) Disarankan: taruh file service account JSON di backend/ (mis. serviceAccount.json)
FIREBASE_SERVICE_ACCOUNT=./serviceAccount.json
# (B) Atau isi tiga variabel ini (kosongkan FIREBASE_SERVICE_ACCOUNT bila pakai cara ini):
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Tempel private_key apa adanya di antara tanda kutip (biarkan \n literalnya)
FIREBASE_PRIVATE_KEY=""

# AI ONNX + dynamic setpoint
# AI_MODEL_DIR=./models
AI_FEEDER_MODE=observe
AI_FEEDER_THRESHOLD=0.62
AI_FEEDER_EVAL_MS=5000
AI_FEEDER_PULSE_MS=4000
AI_FEEDER_COOLDOWN_MS=20000
AI_FEEDER_MANUAL_OVERRIDE_MS=300000

# Hard safety / commissioning guard (tetap independen dari setpoint operator)
AI_FEEDER_MIN_FURNACE_C=550
AI_FEEDER_MAX_FURNACE_C=900
AI_PYRO_HIGH_CUTOFF_C=415

# Envelope model sintetis untuk AUTO
AI_PYRO_MODEL_CENTER_MIN_C=350
AI_PYRO_MODEL_CENTER_MAX_C=440
AI_FURNACE_MODEL_CENTER_MIN_C=700
AI_FURNACE_MODEL_CENTER_MAX_C=900
AI_PYRO_MODEL_MAX_BAND_WIDTH_C=160
AI_FURNACE_MODEL_MAX_BAND_WIDTH_C=180

# Lightweight MPC — bootstrap; kalibrasi dari step-response mesin nyata sebelum AUTO produksi
AI_MPC_HORIZON_SEC=20
AI_MPC_PYRO_DROP_C=3.2
AI_MPC_FURNACE_DROP_C=5.0
AI_MPC_MIN_IMPROVEMENT=0.04
AI_MPC_TREND_WINDOW_MS=60000

# Filter temperatur live yield (EWMA alpha, 0.03–0.50)
AI_TEMP_EWMA_ALPHA=0.18
