{
  "name": "amor-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Backend AMOR — jembatan Firebase ↔ web, API, dan real-time (Socket.io).",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:studio": "prisma studio",
    "seed": "node src/seed.js",
    "prisma:deploy": "prisma migrate deploy",
    "ai:data": "python ../ai/run_all_generators.py",
    "ai:train": "python ../ai/scripts/train_all.py",
    "ai:evaluate": "python ../ai/scripts/evaluate_all.py",
    "ai:deploy": "python ../ai/scripts/deploy_to_backend.py",
    "ai:bootstrap-models": "python scripts/generate-bootstrap-onnx.py"
  },
  "dependencies": {
    "@prisma/client": "^5.19.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "firebase-admin": "^13.10.0",
    "jsonwebtoken": "^9.0.2",
    "onnxruntime-node": "^1.27.0",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "prisma": "^5.19.1"
  },
  "overrides": {
    "adm-zip": "0.6.0"
  }
}
