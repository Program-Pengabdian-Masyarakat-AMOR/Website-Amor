# Contoh konfigurasi frontend. Untuk override lokal, salin ke .env.local.

# --- Mode BACKEND ASLI (default dev) ---
VITE_API_BASE_URL=http://localhost:4000/api
VITE_SOCKET_URL=http://localhost:4000

# --- Mode MOCK (tanpa backend, pakai MSW + fake data) ---
# Aktifkan dengan set berikut (dan boleh kosongkan dua URL di atas):
# VITE_USE_MOCKS=true
